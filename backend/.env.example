# Gin mode (debug/release/test)
GIN_MODE=debug

# Frontend URL (CORS allowed origin)
FRONTEND_URL=http://localhost:3000

# Cookie Secure attribute (true in HTTPS production)
COOKIE_SECURE=false

# Comma-separated trusted reverse proxy CIDRs; leave empty for direct access
TRUSTED_PROXIES=

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=synctask
DB_PASSWORD=synctask_pass
DB_NAME=synctask_dev
DB_SSLMODE=disable
